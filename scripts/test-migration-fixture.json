      "title": "Introducción a Cloudflare Workers",
      "slug": { "current": "introduccion-cloudflare-workers" },
      "publishedAt": "2024-03-15T10:00:00Z",
      "excerpt": "Aprende a desplegar código JavaScript en el edge de la red con Cloudflare Workers.",
      "language": "es",
      "author": { "_ref": "author-001" },
      "categories": [{ "_ref": "cat-tech" }, { "_ref": "cat-cloudflare" }],
      "tags": [{ "_ref": "tag-js" }, { "_ref": "tag-edge" }],
      "mainImage": {
        "asset": { "url": "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1200" },
