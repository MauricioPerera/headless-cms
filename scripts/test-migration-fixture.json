      },
      "body": [
        {
          "_type": "block",
          "_key": "b1",
          "style": "normal",
          "children": [
            { "_type": "span", "_key": "s1", "text": "Cloudflare Workers te permite ejecutar código JavaScript directamente en la red de Cloudflare, con más de 300 ubicaciones alrededor del mundo." }
          ]
        },
        {
          "_type": "block",
          "_key": "b2",
          "style": "h2",
          "children": [
            { "_type": "span", "_key": "s2", "text": "¿Por qué usar Workers?" }
          ]
        },
        {
          "_type": "block",
          "_key": "b3",
          "style": "normal",
          "children": [
            { "_type": "span", "_key": "s3", "text": "La latencia es la principal ventaja: el código se ejecuta a ", "marks": [] },
            { "_type": "span", "_key": "s4", "text": "menos de 50ms", "marks": ["strong"] },
            { "_type": "span", "_key": "s5", "text": " del usuario final." }
          ]
        },
        {
          "_type": "block",
          "_key": "b4",
          "style": "normal",
          "listItem": "bullet",
          "level": 1,
          "children": [{ "_type": "span", "text": "Sin cold starts" }]
        },
        {
          "_type": "block",
          "_key": "b5",
          "style": "normal",
          "listItem": "bullet",
          "level": 1,
          "children": [{ "_type": "span", "text": "Ejecución global automática" }]
        },
        {
          "_type": "block",
          "_key": "b6",
          "style": "normal",
          "listItem": "bullet",
          "level": 1,
          "children": [{ "_type": "span", "text": "100.000 requests/día en el plan gratuito" }]
        },
